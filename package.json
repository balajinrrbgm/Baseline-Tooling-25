{
  "name": "baseline-modernizer",
  "displayName": "Baseline Modernizer",
  "description": "VS Code extension to help developers adopt modern web features using Baseline data",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:html",
    "onLanguage:css"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "baseline-modernizer.analyzeWorkspace",
        "title": "Analyze Workspace for Modern Web Features"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^16.x.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^5.x.x",
    "@typescript-eslint/parser": "^5.x.x",
    "eslint": "^8.x.x",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "compute-baseline": "^0.4.0",
    "node-fetch": "^3.x.x",
    "parse5": "^8.0.0",
    "postcss": "^8.5.23",
    "web-features": "^3.3.0"
  }
}
